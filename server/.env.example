# Server Configuration
PORT=3000

# Clerk Authentication (Get keys at https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# PostgreSQL Database (Neon serverless postgres: https://neon.tech)
DATABASE_URL=postgresql://neondb_owner:password@ep-example.ap-south-1.aws.neon.tech/neondb?sslmode=require

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy...

# Cloudinary Storage (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Clipdrop API (For premium AI image generation: https://clipdrop.co/apis)
CLIPDROP_API_KEY=your_clipdrop_api_key
